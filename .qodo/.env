# Configuração do Banco de Dados (PostgreSQL no Railway)
# Substitua pelos valores fornecidos pelo Railway ou use as variáveis de ambiente do Railway diretamente em produção.
# Formato: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://user:password@host:port/database"

# Segredo para JSON Web Token (JWT)
# Use um valor longo, aleatório e seguro. Você pode gerar um usando `openssl rand -base64 32` no terminal.
JWT_SECRET="K%4Q$H}f8}-O`+:"

# Porta em que a aplicação Node.js vai rodar localmente
PORT=3000